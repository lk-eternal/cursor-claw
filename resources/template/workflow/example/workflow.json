{
  "id": "builtin_feishu_dev_pipeline",
  "name": "飞书需求开发(后端)（示例）",
  "description": "从飞书需求文档出发，编写技术方案 → 实施编码 → 代码检查 → 创建 GitLab MR 的完整开发工作流。\n使用前请在 config.gitlab_token 中填入你的 GitLab 访问令牌。",
  "config": {
    "gitlab_token": "<你的 GitLab Personal Access Token>"
  },
  "nodes": [
    {
      "id": "tech_spec",
      "name": "编写技术方案",
      "promptFile": "nodes/tech_spec.md",
      "maxRetries": 2
    },
    {
      "id": "implement",
      "name": "实施编码",
      "promptFile": "nodes/implement.md",
      "maxRetries": 2
    },
    {
      "id": "review",
      "name": "代码检查",
      "promptFile": "nodes/review.md",
      "maxRetries": 2,
      "isolated": true
    },
    {
      "id": "create_mr",
      "name": "创建GitLab MR",
      "promptFile": "nodes/create_mr.md",
      "maxRetries": 2
    }
  ]
}
